# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.
# These are read only on the server. Never prefix them with NEXT_PUBLIC_.

# Required. Replace the placeholder with your real DeepSeek key.
DEEPSEEK_API_KEY=your-deepseek-key-here

# Optional. The defaults are shown. Use a fast model: answers are needed within seconds,
# and the app always turns DeepSeek's slower "thinking" mode off.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional. When set, visitors must enter this passcode before they can analyze a draft.
APP_PASSCODE=

# Optional. Analyses allowed per visitor every 10 minutes (best effort, per server instance).
RATE_LIMIT_PER_10MIN=6
